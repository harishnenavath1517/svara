# Sarvam — get a key at https://dashboard.sarvam.ai (never commit the real value)
# Copy this file to .env (git-ignored) and paste your key there.
SARVAM_API_KEY=sk_xxxxxxxx_replace_me

# Gateway
GATEWAY_PORT=8787
GATEWAY_WS_PATH=/voice
# Where the Temporal worker dials the gateway for caller audio and hop output.
# Localhost only — this channel has no auth and must never be exposed.
GATEWAY_INTERNAL_WS_URL=ws://localhost:8787
# Energy VAD threshold (RMS over normalized samples). Raise it in a noisy room.
VAD_RMS_THRESHOLD=0.02

# Voice
# bulbul:v3 speakers are lowercase and case-sensitive, and the v2 roster (anushka,
# meera) is REJECTED by v3. See docs/SARVAM_API.md.
TTS_SPEAKER=shubh
# Used when language auto-detect never resolves. bulbul:v3 can't speak "unknown".
DEFAULT_LANGUAGE=hi-IN

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=svara-turns

# Redpanda (Kafka API). 19092 is the external listener from infra/docker-compose.yml;
# 9092 is the in-network one and is not reachable from the host.
REDPANDA_BROKERS=localhost:19092
TRACES_TOPIC=svara.traces
TURNS_TOPIC=svara.turns

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=svara_kb

# Supabase / Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/svara
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=svara-audio

# LLM routing (LiteLLM in front of /v1/chat/completions).
# Point LLM_BASE_URL at a LiteLLM proxy to swap the model without touching the hop.
LLM_BASE_URL=https://api.sarvam.ai/v1
LLM_MODEL=sarvam-30b
JUDGE_MODEL=sarvam-105b

# Web
NEXT_PUBLIC_GATEWAY_WS_URL=ws://localhost:8787/voice
